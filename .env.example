# Copy this file to `.env` and adjust if needed:  cp .env.example .env
# These match the defaults in docker-compose.yml, so the copy works as-is.

# --- The source API (Week 3's new thing) ----------------------------------
# The Rick and Morty API. It's open (no key needed), but you'll still wire auth
# using a common API pattern. If you set a token, your client sends it as
# `Authorization: Bearer <token>` — the same pattern you'd use for GitHub, Stripe,
# etc. Leave it blank for this API.
API_BASE_URL=https://rickandmortyapi.com/api
API_TOKEN=

# --- The raw landing zone (S3 / RustFS, same as Weeks 1-2) ----------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET=raw

# Keep this key for the exercise: the provided loader reads characters.json.
CHARACTERS_KEY=characters.json
